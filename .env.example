# Copia este archivo a .env.local (nunca se commitea) y completa los valores reales.

# Google AI Studio → https://aistudio.google.com/apikey
# Usada por @ai-sdk/google para identificar el producto en la foto (Gemini).
GOOGLE_GENERATIVE_AI_API_KEY=

# Clerk Dashboard → API Keys → Secret key (o `vercel integration add clerk`
# si el proyecto está vinculado a Vercel, que la genera automáticamente).
# Usada por api/scan.ts para verificar la sesión del usuario antes de escanear.
CLERK_SECRET_KEY=
