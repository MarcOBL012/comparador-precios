          "name": "Revisar otra vez enseguida → 429",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"429 con Retry-After (o 502)\", function () {",
                  "  if (pm.response.code === 429) { pm.expect(pm.response.headers.get(\"Retry-After\")).to.be.ok; } else { pm.expect(pm.response.code).to.eql(502); }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
