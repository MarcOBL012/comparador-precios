        {
          "name": "Revisar ahora",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 (ofertas) o 502 (tiendas caídas)\", function () {",
                  "  pm.expect([200, 502]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Dev-User",
                "value": "{{devUser}}"
