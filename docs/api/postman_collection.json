            "description": "Consulta las tiendas reales: 502 si no responden.",
            "url": {
              "raw": "{{baseUrl}}/watches/{{watchId}}/check",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "watches",
                "{{watchId}}",
                "check"
